page {
  min-height: 100%;
  background: #f6f8f7;
  color: #18221f;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input,
textarea,
image {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  border: 0;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx calc(40rpx + env(safe-area-inset-bottom));
}

.surface {
  border: 1rpx solid #e1e8e4;
  border-radius: 24rpx;
  background: #ffffff;
}

.primary-button {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #0aa868;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.primary-button[disabled] {
  background: #a8cabb;
  color: rgba(255, 255, 255, 0.9);
}

.secondary-button {
  display: flex;
  min-height: 72rpx;
  padding: 0 28rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0aa868;
  border-radius: 18rpx;
  color: #078d59;
  font-size: 27rpx;
  font-weight: 650;
}

.muted {
  color: #7a817e;
}

.empty-state {
  padding: 96rpx 40rpx;
  text-align: center;
}

.empty-state__mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  margin: 0 auto 26rpx;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #eaf8f1;
  color: #0aa868;
  font-size: 44rpx;
  font-weight: 800;
}

.empty-state__title {
  display: block;
  color: #26312d;
  font-size: 31rpx;
  font-weight: 700;
}

.empty-state__copy {
  display: block;
  margin-top: 12rpx;
  color: #8a918e;
  font-size: 25rpx;
  line-height: 1.6;
}

.loading-line {
  padding: 80rpx 0;
  color: #8a918e;
  text-align: center;
}
