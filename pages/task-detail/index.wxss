.detail-page {
  padding-top: 28rpx;
}

.detail-loading {
  display: flex;
  min-height: calc(100vh - 56rpx);
  align-items: center;
  justify-content: center;
  flex-direction: column;
}

.detail-loading__stars { position: relative; width: 112rpx; height: 88rpx; }
.detail-loading__star { position: absolute; color: #e2ad32; font-size: 56rpx; line-height: 1; text-shadow: 0 4rpx 12rpx rgba(226, 173, 50, 0.24); }
.detail-loading__star--first { top: 0; left: 0; animation: detail-star-spin 1.2s linear infinite; }
.detail-loading__star--second { right: 0; bottom: 0; color: #f3c557; font-size: 40rpx; animation: detail-star-spin-reverse 1s linear infinite; }
.detail-loading__text { margin-top: 22rpx; color: #8a918e; font-size: 25rpx; }

@keyframes detail-star-spin {
  from { transform: rotate(0deg) scale(0.88); opacity: 0.68; }
  50% { transform: rotate(180deg) scale(1.1); opacity: 1; }
  to { transform: rotate(360deg) scale(0.88); opacity: 0.68; }
}

@keyframes detail-star-spin-reverse {
  from { transform: rotate(360deg) scale(1.08); opacity: 1; }
  50% { transform: rotate(180deg) scale(0.82); opacity: 0.62; }
  to { transform: rotate(0deg) scale(1.08); opacity: 1; }
}

.detail-hero {
  display: flex;
  padding: 32rpx;
  align-items: center;
  gap: 24rpx;
  border-color: #d9f0e4;
  background: #eaf8f1;
}

.subject-mark {
  display: flex;
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #0aa868;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.detail-hero__copy {
  min-width: 0;
}

.detail-title,
.detail-status {
  display: block;
}

.detail-title {
  color: #153b2e;
  font-size: 38rpx;
  font-weight: 800;
}

.detail-status {
  margin-top: 12rpx;
  color: #a07019;
  font-size: 24rpx;
  font-weight: 700;
}

.detail-status--done {
  color: #0aa868;
}

.detail-section,
.voice-section {
  margin-top: 28rpx;
  padding: 8rpx 30rpx;
}

.detail-row {
  display: flex;
  min-height: 92rpx;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
  border-bottom: 1rpx solid #e7ece9;
  color: #7a817e;
  font-size: 26rpx;
}

.detail-row:last-child {
  border-bottom: 0;
}

.detail-row text:last-child {
  color: #25302c;
  font-weight: 700;
  text-align: right;
}

.voice-section {
  padding-top: 28rpx;
  padding-bottom: 30rpx;
}

.voice-title,
.voice-content {
  display: block;
}

.voice-title {
  color: #26312d;
  font-size: 28rpx;
  font-weight: 750;
}

.voice-content {
  margin-top: 18rpx;
  color: #65706b;
  font-size: 27rpx;
  line-height: 1.7;
}

.detail-primary {
  margin-top: 34rpx;
}

.photo-section { margin-top: 28rpx; padding: 28rpx 30rpx; }
.photo-title, .photo-tip { display: block; }
.photo-title { color: #26312d; font-size: 28rpx; font-weight: 750; }
.photo-tip { margin-top: 8rpx; color: #7a817e; font-size: 23rpx; }
.review-photo { display: block; width: 100%; margin-top: 20rpx; border-radius: 14rpx; background: #f4f7f5; }
.original-photo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 20rpx; }
.original-photo { width: 100%; height: 180rpx; border-radius: 10rpx; background: #f4f7f5; }
.review-rounds-section { margin-top: 28rpx; }
.rounds-title, .round-title, .round-label { display: block; }
.rounds-title { margin: 0 0 16rpx; color: #26312d; font-size: 30rpx; font-weight: 800; }
.review-round { margin-top: 18rpx; padding: 28rpx 30rpx; }
.review-round--pending { border-color: #83d9b4; }
.round-title { color: #26312d; font-size: 28rpx; font-weight: 800; }
.round-label { margin-top: 22rpx; color: #69736f; font-size: 24rpx; font-weight: 700; }
.round-image-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.round-original-grid { display: inline-flex; gap: 12rpx; }
.round-original-photo, .round-reviewed-photo { display: inline-block; width: 200rpx; height: 180rpx; border-radius: 10rpx; background: #f4f7f5; }
.round-note { margin-top: 22rpx; padding-top: 20rpx; border-top: 1rpx solid #e7ece9; }
.round-note text { display: block; color: #69736f; font-size: 24rpx; font-weight: 700; }
.round-note text + text { margin-top: 8rpx; color: #25302c; font-weight: 400; line-height: 1.55; white-space: pre-wrap; }
.round-pending-text { display: block; margin-top: 14rpx; color: #7a817e; font-size: 25rpx; }
