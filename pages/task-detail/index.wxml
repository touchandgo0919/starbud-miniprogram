<view class="page-shell detail-page">
  <view wx:if="{{loading}}" class="detail-loading">
    <image class="detail-loading__mark" src="/assets/starbud-loading-mark.png" mode="aspectFit" aria-label="正在加载任务详情" />
  </view>
  <block wx:elif="{{task}}">
    <view class="detail-hero surface">
      <view class="subject-mark">{{task.subjectMark}}</view>
      <view class="detail-hero__copy">
        <text class="detail-title">{{task.title}}</text>
        <text class="detail-status {{task.completed ? 'detail-status--done' : ''}}">{{task.statusLabel}}</text>
      </view>
    </view>

    <view class="detail-section surface">
      <view class="detail-row"><text>执行日期</text><text>{{task.occurrenceDate || "今天"}}</text></view>
      <view class="detail-row"><text>提醒时间</text><text>{{task.scheduleTime}}</text></view>
      <view class="detail-row"><text>重复方式</text><text>{{task.repeatLabel}}</text></view>
      <view class="detail-row"><text>提醒方式</text><text>{{task.voiceLabel}}</text></view>
      <view class="detail-row"><text>领取状态</text><text>{{task.claimLabel}}</text></view>
      <view class="detail-row"><text>提交状态</text><text>{{task.submissionLabel}}</text></view>
    </view>

    <view class="voice-section surface">
      <text class="voice-title">提醒语音内容</text>
      <text class="voice-content">{{task.voiceEnabled ? task.voiceContent : "未开启语音提醒"}}</text>
    </view>

    <view wx:if="{{submission && !submission.reviewRounds.length && submission.reviewImageUrl}}" class="photo-section surface">
      <text class="photo-title">批改后照片</text>
      <text class="photo-tip">默认展示批改结果</text>
      <image class="review-photo" mode="widthFix" src="{{submission.reviewImageUrl}}" bindtap="previewReviewedPhoto" />
    </view>

    <view wx:if="{{submission && !submission.reviewRounds.length && submission.photos.length}}" class="photo-section surface">
      <text class="photo-title">批改前照片</text>
      <view class="original-photo-grid" bindtap="previewOriginalPhotos">
        <image wx:for="{{submission.photos}}" wx:key="id" class="original-photo" mode="aspectFill" src="{{item.url}}" />
      </view>
    </view>

    <view wx:if="{{submission && submission.reviewRounds.length}}" class="review-rounds-section">
      <text class="rounds-title">批改记录</text>
      <view wx:for="{{submission.reviewRounds}}" wx:key="id" wx:for-item="round" class="review-round surface">
        <text class="round-title">第 {{round.sequence}} 次批改</text>
        <text class="round-label">批改前图片</text>
        <scroll-view class="round-image-scroll" scroll-x="true"><view class="round-original-grid"><image wx:for="{{round.photos}}" wx:key="id" wx:for-item="photo" class="round-original-photo" mode="aspectFill" src="{{photo.url}}" data-url="{{photo.url}}" data-urls="{{round.photoUrls}}" bindtap="previewRoundPhoto" /></view></scroll-view>
        <text class="round-label">批改后图片</text>
        <scroll-view class="round-image-scroll" scroll-x="true"><image class="round-reviewed-photo" mode="aspectFill" src="{{round.reviewImageUrl}}" data-url="{{round.reviewImageUrl}}" data-urls="{{round.reviewImageUrl}}" bindtap="previewRoundPhoto" /></scroll-view>
        <view class="round-note"><text>提交备注</text><text>{{round.note || "未填写"}}</text></view>
      </view>
      <view wx:if="{{submission.photos.length && !submission.reviewImageUrl}}" class="review-round review-round--pending surface">
        <text class="round-title">第 {{submission.reviewRounds.length + 1}} 次提交 · 待批改</text>
        <text class="round-label">批改前图片</text>
        <scroll-view class="round-image-scroll" scroll-x="true"><view class="round-original-grid"><image wx:for="{{submission.photos}}" wx:key="id" class="round-original-photo" mode="aspectFill" src="{{item.url}}" data-url="{{item.url}}" data-urls="{{submission.photoUrls}}" bindtap="previewRoundPhoto" /></view></scroll-view>
        <text class="round-label">批改后图片</text>
        <text class="round-pending-text">等待家长批改</text>
        <view class="round-note"><text>提交备注</text><text>{{submission.note || "未填写"}}</text></view>
      </view>
    </view>

    <button
      wx:if="{{isChild && !task.completed && (!task.waitingReview || task.needsRevision)}}"
      class="primary-button detail-primary"
      bindtap="handlePrimaryAction"
    >
      {{task.needsRevision ? "重新提交" : task.claimedAt ? "去完成任务" : "去领取"}}
    </button>
  </block>
</view>
