.tasks-page {
  display: flex;
  height: 100vh;
  min-height: 0;
  padding-bottom: 24rpx;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
}

.greeting {
  display: flex;
  min-height: 194rpx;
  margin-top: 12rpx;
  padding: 36rpx 34rpx;
  align-items: center;
  justify-content: space-between;
  border-color: #d9f0e4;
  background: #eaf8f1;
}

.greeting-title,
.greeting-date {
  display: block;
}

.greeting-title {
  color: #073b2c;
  font-size: 42rpx;
  font-weight: 800;
}

.greeting-date {
  margin-top: 18rpx;
  color: #4f6c61;
  font-size: 26rpx;
}

.greeting-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: transparent;
  color: #0aa868;
  font-size: 40rpx;
  font-weight: 900;
  box-shadow: none;
}

.progress-block {
  padding: 38rpx 8rpx 30rpx;
}

.progress-copy {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.progress-value {
  font-size: 38rpx;
  font-weight: 800;
}

.progress-label {
  color: #7a817e;
  font-size: 25rpx;
}

.progress-track {
  overflow: hidden;
  height: 14rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #edf0ee;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: #0aa868;
  transition: width 240ms ease;
}

.section-heading {
  display: flex;
  padding: 20rpx 8rpx;
  align-items: center;
  justify-content: space-between;
  font-size: 34rpx;
  font-weight: 800;
}

.section-title-group {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.section-count {
  color: #909793;
  font-size: 24rpx;
  font-weight: 500;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: flex-start;
}

.filter-tab {
  display: flex;
  flex: 0 0 68rpx;
  width: 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  height: 48rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f0f3f2;
  color: #61706a;
  font-size: 22rpx;
}

.filter-tab--active {
  background: #0aa868;
  color: #ffffff;
  font-weight: 700;
}

.task-scroll {
  min-height: 0;
  margin-top: 24rpx;
  flex: 1;
}

.task-list {
  overflow: hidden;
  margin-top: 0;
  border-radius: 20rpx;
}

.list-footer {
  padding: 28rpx 0 12rpx;
  color: #8a918e;
  font-size: 24rpx;
  text-align: center;
}

.task-row {
  display: grid;
  min-height: 172rpx;
  padding: 26rpx 22rpx;
  grid-template-columns: 100rpx minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: center;
  border-bottom: 1rpx solid #e7ece9;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #68716d;
  font-size: 25rpx;
  white-space: nowrap;
}

.task-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffc947;
}

.task-dot--done {
  background: #0aa868;
}

.task-copy {
  min-width: 0;
}

.task-description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #25302c;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
}

.task-description {
  margin-top: 12rpx;
  color: #8a918e;
  font-size: 23rpx;
}

.task-control,
.task-status-text {
  display: flex;
  flex: 0 0 auto;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  height: 56rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0aa868;
  border-radius: 14rpx;
  color: #078d59;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.task-actions {
  display: flex;
  flex: 0 0 144rpx;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.task-control {
  height: 40rpx;
}

.task-control--done {
  border-color: #d8dfdc;
  background: #f3f5f4;
  color: #8a9490;
}

.task-control--claim {
  border-color: #e2ad32;
  background: #fff9e8;
  color: #9a6500;
}

.task-control--complete {
  border-color: #0aa868;
  background: #eff8f3;
  color: #078d59;
}

.task-status-text {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  border-color: #f0d38a;
  background: #fff9ea;
  color: #a07019;
}

.task-status-text--done {
  border-color: #b9dfca;
  background: #eff8f3;
  color: #0aa868;
}

.retry-button {
  width: 220rpx;
  margin: 28rpx auto 0;
}
