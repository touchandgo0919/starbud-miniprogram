.tasks-page {
  display: flex;
  height: 100vh;
  min-height: 0;
  padding-bottom: 24rpx;
  padding-top: 0;
  flex-direction: column;
  overflow: hidden;
  background: #ffffff;
}

.top-hero { margin: 0 -28rpx; padding: 0 28rpx; background: linear-gradient(105deg, #08372b 0%, #121418 55%, #0d4331 100%); }
.module-nav { display: flex; padding-right: 190rpx; align-items: center; }
.module-brand { display: flex; height: 76rpx; align-items: center; gap: 14rpx; color: #ffffff; font-size: 30rpx; font-weight: 800; }
.module-brand__logo { width: 48rpx; height: 48rpx; }
.module-search { display: flex; height: 76rpx; margin-top: 28rpx; margin-bottom: 18rpx; padding: 0 22rpx; align-items: center; border-radius: 18rpx; background: #ffffff; }
.module-search__icon { margin-right: 14rpx; color: #7b8781; font-size: 36rpx; line-height: 1; }
.module-search__input { min-width: 0; flex: 1; color: #26312d; font-size: 26rpx; }
.module-search__clear { display: flex; width: 36rpx; height: 36rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e8edeb; color: #708078; font-size: 28rpx; line-height: 1; }

.section-heading {
  display: flex;
  padding: 20rpx 8rpx;
  align-items: center;
  justify-content: space-between;
  font-size: 34rpx;
  font-weight: 800;
}
.top-hero .section-heading { color: #f4f5f7; }
.top-hero .section-count { color: #969ca7; }

.section-title-group {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.section-count {
  color: #909793;
  font-size: 24rpx;
  font-weight: 500;
}

.filter-tabs {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: flex-start;
}

.filter-tab {
  display: flex;
  flex: 0 0 68rpx;
  width: 68rpx;
  min-width: 68rpx;
  max-width: 68rpx;
  height: 48rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f0f3f2;
  color: #61706a;
  font-size: 22rpx;
}

.filter-tab--active {
  background: #0aa868;
  color: #ffffff;
  font-weight: 700;
}

.task-scroll {
  min-height: 0;
  margin-top: 24rpx;
  flex: 1;
}

.task-list {
  overflow: hidden;
  margin-top: 0;
  border-radius: 20rpx;
}

.list-footer {
  padding: 28rpx 0 12rpx;
  color: #8a918e;
  font-size: 24rpx;
  text-align: center;
}

.task-row {
  display: grid;
  min-height: 172rpx;
  padding: 26rpx 22rpx;
  grid-template-columns: 100rpx minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: center;
  border-bottom: 1rpx solid #e7ece9;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #68716d;
  font-size: 25rpx;
  white-space: nowrap;
}

.task-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffc947;
}

.task-dot--done {
  background: #0aa868;
}

.task-copy {
  min-width: 0;
}

.task-description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #25302c;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
}

.task-description {
  margin-top: 12rpx;
  color: #8a918e;
  font-size: 23rpx;
}

.task-control,
.task-status-text {
  display: flex;
  flex: 0 0 auto;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  height: 56rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0aa868;
  border-radius: 14rpx;
  color: #078d59;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.task-actions {
  display: flex;
  flex: 0 0 144rpx;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.task-control {
  height: 50rpx;
}

.task-control--done {
  border-color: #d8dfdc;
  background: #f3f5f4;
  color: #8a9490;
}

.task-control--reviewed {
  border-color: #e5484d;
  background: #fff3f3;
  color: #d7373d;
}

.task-control--claim {
  border-color: #e2ad32;
  background: #fff9e8;
  color: #9a6500;
}

.task-control--complete {
  border-color: #0aa868;
  background: #eff8f3;
  color: #078d59;
}

.task-status-text {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  border-color: #f0d38a;
  background: #fff9ea;
  color: #a07019;
}

.task-status-text--done {
  border-color: #b9dfca;
  background: #eff8f3;
  color: #0aa868;
}

.parent-task-actions {
  display: flex;
  flex: 0 0 144rpx;
  width: 144rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx 14rpx;
}

.parent-task-action {
  color: #078d59;
  font-size: 22rpx;
  line-height: 1.5;
}

.parent-task-action--danger { color: #d95050; }

.retry-button {
  width: 220rpx;
  margin: 28rpx auto 0;
}
