.tasks-page {
  display: flex;
  height: 100vh;
  min-height: 0;
  padding: 0 16rpx 24rpx;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6fa;
}

.tasks-hero {
  margin: 0 -16rpx;
  padding: 0 26rpx;
  background: linear-gradient(105deg, #08372b 0%, #121418 55%, #0d4331 100%);
}

.calendar-panel {
  margin: 20rpx 0 12rpx;
  padding: 20rpx 28rpx 22rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(40, 52, 47, 0.05);
}

.calendar-header,
.calendar-actions,
.calendar-title,
.calendar-weekdays {
  display: flex;
  align-items: center;
}

.calendar-header { height: 54rpx; margin-bottom: 22rpx; justify-content: space-between; }
.calendar-title { gap: 8rpx; color: #111827; font-size: 34rpx; font-weight: 800; line-height: 48rpx; }
.calendar-month-switch { display: flex; width: 34rpx; height: 48rpx; align-items: center; justify-content: center; }
.calendar-month-switch__icon { width: 13rpx; height: 13rpx; border-right: 3rpx solid #88909b; border-bottom: 3rpx solid #88909b; }
.calendar-month-switch__icon--previous { transform: rotate(135deg); }
.calendar-month-switch__icon--next { transform: rotate(-45deg); }
.calendar-actions { gap: 8rpx; }
.calendar-action { min-width: 78rpx; height: 44rpx; padding: 0 16rpx; box-sizing: border-box; border-radius: 999rpx; background: #eaf7ef; color: #00913a; font-size: 24rpx; font-weight: 700; line-height: 44rpx; text-align: center; }
.calendar-toggle { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; }
.calendar-toggle__icon { width: 16rpx; height: 16rpx; border-right: 3rpx solid #88909b; border-bottom: 3rpx solid #88909b; transform: translateY(-3rpx) rotate(45deg); }
.calendar-toggle__icon--up { transform: translateY(3rpx) rotate(225deg); }

.calendar-weekdays { justify-content: space-around; color: #9aa1ad; font-size: 25rpx; font-weight: 700; }
.calendar-weekdays text { width: 14.285%; height: 46rpx; line-height: 46rpx; text-align: center; }

.calendar-days { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); }
.calendar-day { display: flex; height: 78rpx; flex-direction: column; align-items: center; justify-content: center; color: #111827; }
.calendar-day__number { display: flex; width: 46rpx; height: 46rpx; align-items: center; justify-content: center; border-radius: 999rpx; color: inherit; font-size: 30rpx; font-weight: 700; line-height: 30rpx; box-sizing: border-box; }
.calendar-day--outside { color: #c2c8d2; }
.calendar-day--today .calendar-day__number { border: 2rpx solid rgba(0, 145, 58, 0.3); }
.calendar-day--selected .calendar-day__number { border: 0; background: #00913a; color: #ffffff; }
.calendar-day__dot-row { display: flex; height: 14rpx; margin-top: 6rpx; align-items: center; justify-content: center; }
.calendar-day__dot { width: 7rpx; height: 7rpx; border-radius: 50%; background: #00913a; }
.calendar-day__dot--revision { background: #e5484d; }
.calendar-day__dot--review { background: #3b82f6; }
.calendar-day__dot--active { background: #00913a; }
.calendar-day__dot--pending { background: #f2b63d; }
.calendar-day__dot--completed { background: #8a9490; }

.section-heading {
  display: flex;
  box-sizing: border-box;
  padding: 0 10rpx;
  align-items: center;
  justify-content: space-between;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 800;
}

.section-title-group {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.section-title-logo { width: 48rpx; height: 48rpx; }

.section-count {
  color: rgba(255, 255, 255, 0.65);
  font-size: 24rpx;
  font-weight: 500;
}

.task-scroll {
  min-height: 0;
  margin-top: 0;
  flex: 1;
}

.task-list {
  overflow: hidden;
  margin-top: 0;
  border-radius: 20rpx;
}

.list-footer {
  padding: 28rpx 0 12rpx;
  color: #8a918e;
  font-size: 24rpx;
  text-align: center;
}

.task-row {
  display: grid;
  min-height: 172rpx;
  padding: 26rpx 22rpx;
  grid-template-columns: 100rpx minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: center;
  border-bottom: 1rpx solid #e7ece9;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #68716d;
  font-size: 25rpx;
  white-space: nowrap;
}

.task-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffc947;
}

.task-dot--claim { background: #ffc947; }
.task-dot--complete { background: #0aa868; }
.task-dot--waiting-review { background: #3b82f6; }
.task-dot--reviewed { background: #e5484d; }
.task-dot--done {
  background: #8a9490;
}

.task-copy {
  min-width: 0;
}

.task-description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #25302c;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
}

.task-description {
  margin-top: 12rpx;
  color: #8a918e;
  font-size: 23rpx;
}

.task-control,
.task-status-text {
  display: flex;
  flex: 0 0 auto;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  height: 56rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0aa868;
  border-radius: 14rpx;
  color: #078d59;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.task-actions {
  display: flex;
  flex: 0 0 144rpx;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.task-control {
  height: 50rpx;
}

.task-control--done {
  border-color: #d8dfdc;
  background: #f3f5f4;
  color: #8a9490;
}

.task-control--reviewed {
  border-color: #e5484d;
  background: #fff3f3;
  color: #d7373d;
}

.task-control--waiting-review {
  border-color: #3b82f6;
  background: #eff6ff;
  color: #2563eb;
}

.task-control--claim {
  border-color: #e2ad32;
  background: #fff9e8;
  color: #9a6500;
}

.task-control--complete {
  border-color: #0aa868;
  background: #eff8f3;
  color: #078d59;
}

.task-status-text {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  border-color: #f0d38a;
  background: #fff9ea;
  color: #a07019;
}

.task-status-text--done {
  border-color: #b9dfca;
  background: #eff8f3;
  color: #0aa868;
}

.parent-task-actions {
  display: flex;
  flex: 0 0 104rpx;
  width: 104rpx;
  flex-direction: column;
  gap: 8rpx;
}

.parent-task-action {
  display: flex;
  width: 104rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0aa868;
  border-radius: 14rpx;
  background: #eff8f3;
  color: #078d59;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
}

.parent-task-action--danger { border-color: #e5484d; background: #fff3f3; color: #d7373d; }

.retry-button {
  width: 220rpx;
  margin: 28rpx auto 0;
}
