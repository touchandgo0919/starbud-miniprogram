.tasks-page {
  display: flex;
  height: 100vh;
  min-height: 0;
  padding: 0 16rpx 24rpx;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6fa;
}

.calendar-panel {
  margin: 0 -16rpx;
  padding: 20rpx 28rpx 22rpx;
  border-radius: 0 0 24rpx 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(40, 52, 47, 0.05);
}

.calendar-header,
.calendar-actions,
.calendar-title,
.calendar-month-switch,
.calendar-weekdays,
.calendar-legend {
  display: flex;
  align-items: center;
}

.calendar-header { height: 54rpx; justify-content: space-between; }
.calendar-month-switch { gap: 10rpx; }
.calendar-month-arrow { display: flex; width: 38rpx; height: 44rpx; align-items: center; justify-content: center; color: #7b8692; font-size: 42rpx; font-weight: 400; line-height: 1; }
.calendar-title { gap: 10rpx; color: #202936; font-size: 32rpx; font-weight: 800; }
.calendar-title__chevron { color: #66717d; font-size: 34rpx; line-height: 1; }
.calendar-actions { gap: 12rpx; }
.calendar-action { padding: 8rpx 14rpx; border-radius: 999rpx; background: #eef8f2; color: #078d59; font-size: 22rpx; font-weight: 700; }
.calendar-toggle { display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; color: #7b8692; font-size: 32rpx; line-height: 1; }

.calendar-weekdays { margin-top: 20rpx; justify-content: space-around; color: #929dab; font-size: 23rpx; font-weight: 700; }
.calendar-weekdays text { width: 14.285%; text-align: center; }

.calendar-days { display: grid; margin-top: 14rpx; grid-template-columns: repeat(7, minmax(0, 1fr)); row-gap: 10rpx; }
.calendar-days--expanded { row-gap: 8rpx; }
.calendar-day { position: relative; display: flex; height: 48rpx; align-items: center; justify-content: center; color: #202936; font-size: 28rpx; font-weight: 700; }
.calendar-day__number { position: relative; z-index: 1; display: flex; width: 44rpx; height: 44rpx; align-items: center; justify-content: center; border-radius: 50%; }
.calendar-day--outside { color: #bec6d1; }
.calendar-day--selected .calendar-day__number { background: #09a85e; color: #ffffff; }
.calendar-day__dot { position: absolute; bottom: 0; width: 7rpx; height: 7rpx; border-radius: 50%; background: #08a35d; }
.calendar-day--selected .calendar-day__dot { bottom: -2rpx; background: #08a35d; }
.calendar-legend { margin-top: 12rpx; justify-content: flex-end; gap: 8rpx; color: #7a858f; font-size: 20rpx; }
.calendar-legend text:first-child { width: 7rpx; height: 7rpx; border-radius: 50%; background: #08a35d; }

.section-heading {
  display: flex;
  box-sizing: border-box;
  padding: 0 10rpx;
  align-items: center;
  justify-content: space-between;
  color: #25302c;
  font-size: 34rpx;
  font-weight: 800;
}

.section-title-group {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.section-count {
  color: #909793;
  font-size: 24rpx;
  font-weight: 500;
}

.task-scroll {
  min-height: 0;
  margin-top: 0;
  flex: 1;
}

.task-list {
  overflow: hidden;
  margin-top: 0;
  border-radius: 20rpx;
}

.list-footer {
  padding: 28rpx 0 12rpx;
  color: #8a918e;
  font-size: 24rpx;
  text-align: center;
}

.task-row {
  display: grid;
  min-height: 172rpx;
  padding: 26rpx 22rpx;
  grid-template-columns: 100rpx minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: center;
  border-bottom: 1rpx solid #e7ece9;
}

.task-row:last-child {
  border-bottom: 0;
}

.task-time {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #68716d;
  font-size: 25rpx;
  white-space: nowrap;
}

.task-dot {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ffc947;
}

.task-dot--done {
  background: #0aa868;
}

.task-copy {
  min-width: 0;
}

.task-description {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  color: #25302c;
  font-size: 30rpx;
  font-weight: 750;
  line-height: 1.35;
}

.task-description {
  margin-top: 12rpx;
  color: #8a918e;
  font-size: 23rpx;
}

.task-control,
.task-status-text {
  display: flex;
  flex: 0 0 auto;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  height: 56rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #0aa868;
  border-radius: 14rpx;
  color: #078d59;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.task-actions {
  display: flex;
  flex: 0 0 144rpx;
  width: 144rpx;
  min-width: 144rpx;
  max-width: 144rpx;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.task-control {
  height: 50rpx;
}

.task-control--done {
  border-color: #d8dfdc;
  background: #f3f5f4;
  color: #8a9490;
}

.task-control--reviewed {
  border-color: #e5484d;
  background: #fff3f3;
  color: #d7373d;
}

.task-control--claim {
  border-color: #e2ad32;
  background: #fff9e8;
  color: #9a6500;
}

.task-control--complete {
  border-color: #0aa868;
  background: #eff8f3;
  color: #078d59;
}

.task-status-text {
  width: 72rpx;
  min-width: 72rpx;
  max-width: 72rpx;
  border-color: #f0d38a;
  background: #fff9ea;
  color: #a07019;
}

.task-status-text--done {
  border-color: #b9dfca;
  background: #eff8f3;
  color: #0aa868;
}

.parent-task-actions {
  display: flex;
  flex: 0 0 144rpx;
  width: 144rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 10rpx 14rpx;
}

.parent-task-action {
  color: #078d59;
  font-size: 22rpx;
  line-height: 1.5;
}

.parent-task-action--danger { color: #d95050; }

.retry-button {
  width: 220rpx;
  margin: 28rpx auto 0;
}
