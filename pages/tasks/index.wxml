<view class="page-shell tasks-page">
  <view class="tasks-hero">
    <view class="section-heading" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="section-title-group">
        <image class="section-title-logo" src="/assets/starbud-icon.png" mode="aspectFit" />
        <text>{{isParent ? '家庭任务' : '我的任务'}}</text>
        <text class="section-count">{{totalCount}} 项</text>
      </view>
    </view>
  </view>

  <view class="calendar-panel" bindtouchstart="onCalendarTouchStart" bindtouchend="onCalendarTouchEnd">
    <view class="calendar-header">
      <view class="calendar-title">
        <view class="calendar-month-switch" data-offset="-1" catchtap="changeCalendarMonth">
          <view class="calendar-month-switch__icon calendar-month-switch__icon--previous"></view>
        </view>
        <text>{{calendarTitle}}</text>
        <view class="calendar-month-switch" data-offset="1" catchtap="changeCalendarMonth">
          <view class="calendar-month-switch__icon calendar-month-switch__icon--next"></view>
        </view>
      </view>
      <view class="calendar-actions">
        <view wx:if="{{calendarExpanded}}" class="calendar-action" bindtap="showCurrentMonth">本月</view>
        <view class="calendar-action" bindtap="selectToday">今天</view>
        <view class="calendar-toggle" bindtap="toggleCalendar">
          <view class="calendar-toggle__icon {{calendarExpanded ? 'calendar-toggle__icon--up' : ''}}"></view>
        </view>
      </view>
    </view>

    <view class="calendar-weekdays">
      <text wx:for="{{weekdayLabels}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="calendar-days {{calendarExpanded ? 'calendar-days--expanded' : ''}}">
      <view
        wx:for="{{calendarDays}}"
        wx:key="key"
        class="calendar-day {{item.isCurrentMonth ? '' : 'calendar-day--outside'}} {{item.isToday ? 'calendar-day--today' : ''}} {{item.isSelected ? 'calendar-day--selected' : ''}}"
        data-date="{{item.key}}"
        bindtap="selectCalendarDate"
      >
        <text class="calendar-day__number">{{item.label}}</text>
        <view class="calendar-day__dot-row"><text wx:if="{{item.hasTask}}" class="calendar-day__dot {{item.dotClass}}"></text></view>
      </view>
    </view>
  </view>

  <scroll-view
    class="task-scroll"
    scroll-y
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onTaskRefresh"
    bindscrolltolower="loadMoreTasks"
    lower-threshold="120"
  >
    <view wx:if="{{loading}}" class="loading-line">正在加载任务…</view>
    <view wx:elif="{{error}}" class="empty-state surface">
      <text class="empty-state__mark">!</text>
      <text class="empty-state__title">任务加载失败</text>
      <text class="empty-state__copy">{{error}}</text>
      <button class="secondary-button retry-button" bindtap="refreshTaskPage">重新加载</button>
    </view>
    <view wx:elif="{{!tasks.length}}" class="empty-state surface">
      <text class="empty-state__mark">✓</text>
      <text class="empty-state__title">该日期还没有任务</text>
      <text class="empty-state__copy">可以先休息一下，任务会由家长在网页端安排。</text>
    </view>
    <view wx:else class="task-list surface">
      <view wx:for="{{tasks}}" wx:key="id" class="task-row" data-id="{{item.id}}" bindtap="handleTaskDetail">
        <view class="task-time">
          <text>{{item.scheduleTime}}</text>
          <view class="task-dot {{item.dotClass}}"></view>
        </view>
        <view class="task-copy">
          <text class="task-title">{{item.title}}</text>
          <text class="task-description">{{item.description}}</text>
        </view>
        <view class="task-actions">
          <view wx:if="{{!isParent && item.canChildAct}}" class="{{item.actionClass}}" data-id="{{item.id}}" catchtap="handleTaskAction"><text class="task-control__label">{{item.actionText}}</text></view>
          <view wx:elif="{{!isParent}}" class="{{item.actionClass}}"><text class="task-control__label">{{item.actionText}}</text></view>
          <view wx:else class="parent-task-actions">
            <view wx:if="{{item.canParentRemind}}" class="parent-task-action parent-task-action--{{item.parentReminderType}}" data-id="{{item.id}}" catchtap="remindTask">{{item.parentReminderLabel}}</view>
            <view wx:else class="parent-task-status">{{item.parentStatusLabel}}</view>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="list-footer">正在加载更多任务…</view>
  </scroll-view>
</view>
