<view class="page-shell history-page">
  <view class="top-hero">
    <view class="module-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="module-brand">
        <image class="module-brand__logo" src="/assets/starbud-icon.png" mode="aspectFit" />
        <text>我的提交</text>
        <text class="module-brand__count">{{totalCount}} 项</text>
      </view>
    </view>
  </view>

    <view class="history-toolbar">
      <view class="history-search surface">
        <text class="history-search__icon">⌕</text>
        <input class="history-search__input" value="{{keyword}}" placeholder="搜索提交" confirm-type="search" bindinput="onSearchInput" />
        <view wx:if="{{keyword}}" class="history-search__clear" bindtap="clearSearch">×</view>
      </view>
      <view class="filter-tabs">
        <view wx:for="{{filters}}" wx:key="value" class="filter-tab {{activeFilter === item.value ? 'filter-tab--active' : ''}}" data-value="{{item.value}}" bindtap="selectFilter">{{item.label}}</view>
      </view>
    </view>

  <scroll-view
    class="history-scroll"
    scroll-y
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onHistoryRefresh"
    bindscrolltolower="loadMoreSubmissions"
    lower-threshold="120"
  >
    <view wx:if="{{loading}}" class="loading-line">正在加载提交记录…</view>
    <view wx:elif="{{error}}" class="empty-state surface">
      <text class="empty-state__mark">!</text>
      <text class="empty-state__title">记录加载失败</text>
      <text class="empty-state__copy">{{error}}</text>
      <button class="secondary-button retry-button" bindtap="loadSubmissions">重新加载</button>
    </view>
    <view wx:elif="{{!submissions.length}}" class="empty-state surface">
      <text class="empty-state__mark">照</text>
      <text class="empty-state__title">暂无提交记录</text>
      <text class="empty-state__copy">完成任务并提交照片或录音后，会在这里留下记录。</text>
    </view>
    <view wx:else class="history-list surface">
      <view wx:for="{{submissions}}" wx:key="id" class="history-row">
        <view class="history-head">
          <view class="subject-mark">{{item.subjectMark}}</view>
          <view class="history-copy">
            <text class="history-title">{{item.taskTitle}}</text>
            <text class="history-time">提交时间：{{item.submittedLabel}}</text>
          </view>
          <text class="history-status {{item.statusClass}}">{{item.statusLabel}}</text>
        </view>
        <scroll-view class="photo-strip" scroll-x enhanced show-scrollbar="{{false}}">
          <image
            wx:for="{{item.photos}}"
            wx:for-item="photo"
            wx:key="id"
            class="history-photo"
            src="{{photo.url}}"
            mode="aspectFill"
            data-submission="{{item.id}}"
            data-url="{{photo.url}}"
            bindtap="previewPhoto"
          />
        </scroll-view>
        <view wx:if="{{!isParent && editingSubmissionId === item.id}}" class="history-note-editor">
          <textarea value="{{editingNote}}" maxlength="500" placeholder="填写提交备注" auto-height bindinput="onNoteInput" />
          <view class="history-note-editor__actions"><text bindtap="cancelEditNote">取消</text><text class="history-note-editor__save" bindtap="saveNote">保存</text></view>
        </view>
        <view wx:else class="history-note-wrap">
          <text class="history-note">{{item.note || "未填写备注"}}</text>
          <view wx:if="{{!isParent && item.canEditNote}}" class="history-note-actions">
            <text class="history-note-edit" data-id="{{item.id}}" bindtap="startEditNote">编辑备注</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="history-footer">正在加载更多提交记录…</view>
  </scroll-view>
</view>
