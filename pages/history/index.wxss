.history-page {
  display: flex;
  height: 100vh;
  min-height: 0;
  padding: 0 16rpx 24rpx;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6fa;
}

.top-hero { margin: 0 -16rpx; padding: 0 26rpx; background: linear-gradient(105deg, #08372b 0%, #121418 55%, #0d4331 100%); }
.module-nav { display: flex; box-sizing: border-box; padding: 0 10rpx; align-items: center; }
.module-brand { display: flex; align-items: center; gap: 14rpx; color: #ffffff; font-size: 34rpx; font-weight: 800; }
.module-brand__logo { width: 44rpx; height: 44rpx; }
.module-brand__count { color: rgba(255, 255, 255, 0.65); font-size: 24rpx; font-weight: 500; }

.history-toolbar { display: flex; margin: 20rpx 0 12rpx; padding: 20rpx 28rpx; align-items: center; gap: 12rpx; border-radius: 24rpx; background: #ffffff; box-shadow: 0 8rpx 24rpx rgba(40, 52, 47, 0.05); }

.history-search {
  display: flex;
  height: 76rpx;
  min-width: 0;
  padding: 0 22rpx;
  align-items: center;
  border-radius: 18rpx;
  background: #ffffff;
  flex: 1;
}

.history-search__icon {
  margin-right: 14rpx;
  color: #7b8781;
  font-size: 36rpx;
  line-height: 1;
}

.history-search__input {
  min-width: 0;
  flex: 1;
  color: #26312d;
  font-size: 26rpx;
}

.history-search__clear {
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #e8edeb;
  color: #708078;
  font-size: 28rpx;
  line-height: 1;
}

.history-heading {
  display: flex;
  padding: 20rpx 8rpx;
  align-items: center;
  justify-content: space-between;
  font-size: 34rpx;
  font-weight: 800;
}
.top-hero .history-heading { color: #f4f5f7; }
.top-hero .history-count { color: #969ca7; }

.history-title-group {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}

.history-count {
  color: #909793;
  font-size: 24rpx;
  font-weight: 500;
}

.filter-tabs {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: flex-start;
}

.filter-tab {
  display: flex;
  flex: 0 0 58rpx;
  width: 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  height: 48rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #f0f3f2;
  color: #61706a;
  font-size: 22rpx;
}

.filter-tab--active {
  background: #0aa868;
  color: #ffffff;
  font-weight: 700;
}

.history-scroll {
  min-height: 0;
  margin-top: 0;
  flex: 1;
}

.history-list {
  overflow: hidden;
  margin-top: 0;
}

.history-footer {
  padding: 28rpx 0 12rpx;
  color: #8a918e;
  font-size: 24rpx;
  text-align: center;
}

.history-row {
  padding: 28rpx;
  border-bottom: 1rpx solid #e5ebe8;
}

.history-row:last-child {
  border-bottom: 0;
}

.history-head {
  display: grid;
  grid-template-columns: 72rpx minmax(0, 1fr) auto;
  gap: 18rpx;
  align-items: center;
}

.subject-mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #0aa868;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
}

.history-copy {
  min-width: 0;
}

.history-title,
.history-time {
  display: block;
}

.history-title {
  overflow: hidden;
  color: #26312d;
  font-size: 29rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.history-time {
  margin-top: 8rpx;
  color: #8a918e;
  font-size: 22rpx;
}

.history-status {
  color: #0aa868;
  font-size: 24rpx;
  font-weight: 700;
}

.history-status--completed { color: #8a918e; }

.photo-strip {
  width: 100%;
  margin-top: 22rpx;
  white-space: nowrap;
}

.history-photo {
  width: 168rpx;
  height: 132rpx;
  margin-right: 14rpx;
  border-radius: 14rpx;
  background: #edf0ee;
}

.history-note-wrap,
.history-note-editor {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #f5f8f6;
}

.history-note {
  display: block;
  color: #64706b;
  font-size: 24rpx;
  line-height: 1.55;
}

.history-note-actions { display: flex; gap: 24rpx; margin-top: 12rpx; }
.history-note-edit { color: #078d59; font-size: 23rpx; font-weight: 700; }
.history-note-resubmit { color: #d7373d; }
.history-note-editor textarea { width: 100%; min-height: 72rpx; color: #26312d; font-size: 25rpx; line-height: 1.5; }
.history-note-editor__actions { display: flex; justify-content: flex-end; gap: 28rpx; margin-top: 14rpx; color: #7a817e; font-size: 24rpx; }
.history-note-editor__save { color: #078d59; font-weight: 700; }

.retry-button {
  width: 220rpx;
  margin: 28rpx auto 0;
}
