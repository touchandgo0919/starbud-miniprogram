.submit-page {
  padding-bottom: 180rpx;
}

.task-summary {
  display: grid;
  padding: 28rpx;
  grid-template-columns: 78rpx minmax(0, 1fr);
  gap: 22rpx;
  align-items: center;
}

.subject-mark {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #0aa868;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 800;
}

.task-summary__copy {
  min-width: 0;
}

.task-summary__title,
.task-summary__description {
  display: block;
}

.task-summary__title {
  color: #1d2924;
  font-size: 34rpx;
  font-weight: 800;
}

.task-summary__description {
  overflow: hidden;
  margin-top: 10rpx;
  color: #7a817e;
  font-size: 24rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  display: flex;
  padding-top: 22rpx;
  grid-column: 1 / -1;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid #e5ebe8;
  color: #7a817e;
  font-size: 24rpx;
}

.task-meta__value {
  color: #26312d;
  font-weight: 700;
}

.form-section {
  margin-top: 38rpx;
}

.form-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.form-title {
  color: #26312d;
  font-size: 31rpx;
  font-weight: 750;
}

.form-hint {
  color: #8a918e;
  font-size: 23rpx;
}

.draft-recovery-note {
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #eaf8f1;
  color: #078d59;
  font-size: 23rpx;
  line-height: 1.5;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
  gap: 16rpx;
}

.photo-cell,
.photo-add {
  position: relative;
  flex: 0 0 160rpx;
  width: 160rpx;
  min-width: 160rpx;
  max-width: 160rpx;
  height: 160rpx;
  min-height: 160rpx;
  max-height: 160rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.photo-image {
  display: block;
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  left: auto;
  z-index: 1;
  display: flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(245, 247, 246, 0.9);
  color: #718079;
  font-size: 30rpx;
  line-height: 1;
}

.photo-uploaded {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 8rpx 0;
  background: rgba(7, 141, 89, 0.88);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 1;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #b9c8c0;
  background: #fbfcfb;
  color: #078d59;
  font-size: 23rpx;
}

.photo-add__icon {
  margin-bottom: 12rpx;
  font-size: 50rpx;
  font-weight: 300;
}

.audio-card {
  display: flex;
  min-height: 112rpx;
  margin-top: 22rpx;
  padding: 20rpx 22rpx;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid #dce5e0;
  border-radius: 18rpx;
  background: #fbfcfb;
  color: #26312d;
  font-size: 25rpx;
}

.recording-time {
  color: #c74c57;
  font-weight: 700;
}

.record-button,
.audio-action {
  margin: 0;
  border-radius: 12rpx;
  background: #0aa868;
  color: #ffffff;
  font-size: 23rpx;
}

.record-button--stop,
.audio-action--danger {
  background: #c74c57;
}

.audio-action + .audio-action {
  margin-left: 12rpx;
}

.audio-card__actions {
  display: flex;
  align-items: center;
}

.note-input {
  width: 100%;
  height: 240rpx;
  margin-top: 22rpx;
  padding: 24rpx;
  border: 2rpx solid #dce5e0;
  border-radius: 18rpx;
  background: #ffffff;
  color: #26312d;
  font-size: 27rpx;
  line-height: 1.6;
}

.note-placeholder {
  color: #a2a9a5;
}

.note-count {
  display: block;
  margin-top: 10rpx;
  color: #9aa19e;
  font-size: 22rpx;
  text-align: right;
}

.privacy-note {
  margin-top: 34rpx;
  color: #8a918e;
  font-size: 23rpx;
  line-height: 1.6;
  text-align: center;
}

.submit-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e3e9e6;
  background: rgba(255, 255, 255, 0.98);
}

.upload-progress {
  display: block;
  margin-bottom: 14rpx;
  color: #078d59;
  font-size: 23rpx;
  text-align: center;
}
