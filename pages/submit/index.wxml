<view class="page-shell submit-page" wx:if="{{task}}">
  <view class="task-summary surface">
    <view class="subject-mark">{{task.subjectMark}}</view>
    <view class="task-summary__copy">
      <text class="task-summary__title">{{task.title}}</text>
      <text class="task-summary__description">{{task.voiceContent}}</text>
    </view>
    <view class="task-meta">
      <text>提醒时间</text>
      <text class="task-meta__value">{{task.scheduleTime}}</text>
    </view>
  </view>

  <view class="attachment-tip">图片和录音至少提交一项，录音最多 3 分钟</view>
  <view wx:if="{{recoveredDraft}}" class="draft-recovery-note">已恢复草稿附件，可继续提交或补传照片、重新录音。</view>

  <view class="form-section form-section--photos">
    <text class="field-label">图片</text>

    <view class="photo-grid">
      <view wx:for="{{existingPhotos}}" wx:key="id" class="photo-cell">
        <image
          class="photo-image"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          bindtap="previewExistingPhoto"
        />
        <view class="photo-uploaded">已上传</view>
      </view>
      <view wx:for="{{photos}}" wx:key="path" class="photo-cell">
        <image
          class="photo-image"
          src="{{item.path}}"
          mode="aspectFill"
          data-path="{{item.path}}"
          bindtap="previewPhoto"
        />
        <view class="photo-remove" data-index="{{index}}" catchtap="removePhoto">×</view>
      </view>
      <view wx:if="{{existingPhotos.length + photos.length < 8}}" class="photo-add" bindtap="choosePhotos">
        <text class="photo-add__icon">＋</text>
        <text class="attachment-add__label">拍照 / 相册</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="field-label">录音</text>
    <view class="photo-grid">
      <view wx:if="{{recording}}" class="audio-cell audio-cell--recording" bindtap="stopRecording">
        <view class="audio-recording-main">
          <view class="audio-level" aria-label="实时录音音量">
            <view
              wx:for="{{recordingLevels}}"
              wx:key="index"
              class="audio-level__bar"
              style="height: {{item}}rpx;"
            ></view>
          </view>
          <text class="audio-cell__icon">■</text>
        </view>
        <text class="recording-time">{{recordingDuration}} 秒</text>
        <view class="audio-cell__status audio-cell__status--danger">停止</view>
      </view>
      <view wx:elif="{{audio || existingAudio}}" class="audio-cell {{audioPlaying ? 'audio-cell--playing' : ''}}">
        <view class="audio-cell__main" bindtap="playAudio">
          <text class="audio-cell__icon">{{audioLoading ? '…' : audioPlaying ? '❚❚' : '▶'}}</text>
          <text class="audio-cell__duration">{{audioPlaybackLabel ? audioPlaybackLabel + ' / ' + audioDurationLabel : audioDurationLabel}}</text>
        </view>
        <view class="photo-remove" catchtap="deleteAudio">×</view>
        <view class="audio-cell__status">{{audioLoading ? "加载中" : audioPlaying ? "暂停" : "试听"}}</view>
      </view>
      <view wx:else class="audio-add" bindtap="startRecording">
        <text class="audio-cell__icon">●</text>
        <text class="attachment-add__label">录音</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="field-label">备注（选填）</text>
    <textarea
      class="note-input"
      value="{{note}}"
      placeholder="可以填写作业中遇到的问题或想补充的内容…"
      placeholder-class="note-placeholder"
      maxlength="500"
      show-confirm-bar="{{false}}"
      bindinput="onNoteInput"
    />
    <text class="note-count">{{note.length}} / 500</text>
  </view>

  <view class="privacy-note">照片和录音仅用于本次作业提交，请勿上传与作业无关的内容。</view>
  <view class="submit-spacer"></view>
  <view class="submit-bar">
    <text wx:if="{{uploadProgress}}" class="upload-progress">{{uploadProgress}}</text>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{recoveredDraft ? "继续提交作业" : resubmitSubmissionId ? "重新提交作业" : "提交作业"}}
    </button>
  </view>
</view>
