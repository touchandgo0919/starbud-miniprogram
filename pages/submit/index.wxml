<view class="page-shell submit-page" wx:if="{{task}}">
  <view class="task-summary surface">
    <view class="subject-mark">{{task.subjectMark}}</view>
    <view class="task-summary__copy">
      <text class="task-summary__title">{{task.title}}</text>
      <text class="task-summary__description">{{task.voiceContent}}</text>
    </view>
    <view class="task-meta">
      <text>提醒时间</text>
      <text class="task-meta__value">{{task.scheduleTime}}</text>
    </view>
  </view>

  <view class="form-section">
    <view class="form-heading">
      <text class="form-title">作业照片</text>
      <text class="form-hint">照片或录音至少提交一项</text>
    </view>
    <view wx:if="recoveredDraft" class="draft-recovery-note">已恢复草稿附件，可继续提交或补传照片、重新录音。</view>

    <view class="photo-grid">
      <view wx:for="{{existingPhotos}}" wx:key="id" class="photo-cell">
        <image
          class="photo-image"
          src="{{item.url}}"
          mode="aspectFill"
          data-url="{{item.url}}"
          bindtap="previewExistingPhoto"
        />
        <view class="photo-uploaded">已上传</view>
      </view>
      <view wx:for="{{photos}}" wx:key="path" class="photo-cell">
        <image
          class="photo-image"
          src="{{item.path}}"
          mode="aspectFill"
          data-path="{{item.path}}"
          bindtap="previewPhoto"
        />
        <view class="photo-remove" data-index="{{index}}" catchtap="removePhoto">×</view>
      </view>
      <view wx:if="{{existingPhotos.length + photos.length < 8}}" class="photo-add" bindtap="choosePhotos">
        <text class="photo-add__icon">＋</text>
        <text>拍照 / 相册</text>
      </view>
    </view>
  </view>

  <view class="form-section">
    <view class="form-heading"><text class="form-title">语音说明</text><text class="form-hint">选填，最长 3 分钟</text></view>
    <view class="audio-card">
      <text wx:if="recording" class="recording-time">录音中 {{recordingDuration}} 秒</text>
      <text wx:elif="audio || existingAudio">语音附件 {{audioDurationLabel}}</text>
      <text wx:else>添加一段语音说明</text>
      <view class="audio-card__actions">
        <button wx:if="recording" class="audio-action audio-action--danger" size="mini" bindtap="stopRecording">停止</button>
        <block wx:elif="audio || existingAudio"><button class="audio-action" size="mini" bindtap="playAudio">试听</button><button class="audio-action" size="mini" bindtap="startRecording">重录</button></block>
        <button wx:else class="audio-action" size="mini" bindtap="startRecording">录音</button>
      </view>
    </view>
  </view>

  <view class="form-section">
    <text class="form-title">补充说明（选填）</text>
    <textarea
      class="note-input"
      value="{{note}}"
      placeholder="可以填写作业中遇到的问题或想补充的内容…"
      placeholder-class="note-placeholder"
      maxlength="500"
      show-confirm-bar="{{false}}"
      bindinput="onNoteInput"
    />
    <text class="note-count">{{note.length}} / 500</text>
  </view>

  <view class="privacy-note">照片和录音仅用于本次作业提交，请勿上传与作业无关的内容。</view>
  <view class="submit-spacer"></view>
  <view class="submit-bar">
    <text wx:if="{{uploadProgress}}" class="upload-progress">{{uploadProgress}}</text>
    <button class="primary-button" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">
      {{recoveredDraft ? "继续提交作业" : resubmitSubmissionId ? "重新提交作业" : "提交作业"}}
    </button>
  </view>
</view>
