<view class="page-shell profile-page" wx:if="{{user}}">
  <view class="top-hero">
    <view class="module-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="module-brand">
        <image class="module-brand__logo" src="/assets/starbud-icon.png" mode="aspectFit" />
        <text>星星芽AI助手</text>
      </view>
    </view>
  </view>

  <view class="profile-card surface">
    <image class="profile-logo" src="/assets/starbud-icon.png" mode="aspectFill" />
    <view class="profile-copy">
      <text class="profile-name">{{user.displayName}}</text>
      <text class="profile-username">@{{user.username}}</text>
    </view>
    <text class="profile-role">{{user.role === "parent" ? "家长账号" : "儿童账号"}}</text>
  </view>

  <view wx:if="{{user.role === 'parent'}}" class="responsibility surface">
    <text class="responsibility-title">家长可以查看什么</text>
    <view class="responsibility-row">
      <text class="responsibility-index">1</text>
      <text>查看孩子的今日任务</text>
    </view>
    <view class="responsibility-row">
      <text class="responsibility-index">2</text>
      <text>查看任务完成状态和进度</text>
    </view>
    <view class="responsibility-row">
      <text class="responsibility-index">3</text>
      <text>查看孩子已提交的作业记录</text>
    </view>
  </view>

  <view wx:else class="responsibility surface">
    <text class="responsibility-title">这个小程序用来做什么</text>
    <view class="responsibility-row">
      <text class="responsibility-index">1</text>
      <text>领取家长安排的今日任务</text>
    </view>
    <view class="responsibility-row">
      <text class="responsibility-index">2</text>
      <text>完成后拍照或从相册选择作业照片</text>
    </view>
    <view class="responsibility-row">
      <text class="responsibility-index">3</text>
      <text>提交作业并查看自己的提交记录</text>
    </view>
  </view>

  <view wx:if="{{user.role === 'parent'}}" class="scope-note">
    家长仍可在网页端安排作业；小程序用于查看孩子的任务和提交状态。
  </view>
  <view wx:else class="scope-note">
    家长在网页端安排作业；电脑 App 负责语音提醒。小程序不提供任务创建或语音设置。
  </view>

  <button class="logout-button" bindtap="logout">退出登录</button>
</view>
