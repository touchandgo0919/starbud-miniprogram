<view class="reward-page" wx:if="{{center}}">
  <view class="reward-hero"><text>我的星芽积分</text><strong>{{center.balance}}</strong><text>完成一项任务 +{{center.settings.taskPoints}}；连续 {{center.settings.streakDays}} 天额外 +{{center.settings.streakBonusPoints}}</text></view>
  <view class="reward-section"><text class="section-title">可以兑换</text><view class="reward-card" wx:for="{{center.rewards}}" wx:key="id" wx:if="{{item.active}}"><view><strong>{{item.title}}</strong><text>{{item.description || '家长准备的奖励'}}</text></view><view><text class="cost">{{item.pointCost}} 分</text><button size="mini" type="primary" data-reward="{{item}}" disabled="{{center.balance < item.pointCost}}" bindtap="redeem">兑换</button></view></view><text wx:if="{{!center.rewards.length}}" class="empty">家长还没有设置奖励。</text></view>
  <view class="reward-section"><text class="section-title">我的兑换申请</text><view class="request-row" wx:for="{{center.redemptions}}" wx:key="id"><view><strong>{{item.title}}</strong><text>{{item.pointCost}} 分</text></view><text class="status {{item.status}}">{{item.status === 'pending' ? '等待确认' : item.status === 'approved' ? '已确认' : '未通过'}}</text></view><text wx:if="{{!center.redemptions.length}}" class="empty">暂时没有兑换申请。</text></view>
</view>
