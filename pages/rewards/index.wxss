.reward-page { min-height: 100vh; padding: 28rpx; background: #f5faf7; box-sizing: border-box; }.reward-hero { display: flex; flex-direction: column; gap: 12rpx; padding: 40rpx; border-radius: 24rpx; color: #eafff4; background: linear-gradient(135deg, #087d54, #18bd78); }.reward-hero strong { font-size: 72rpx; line-height: 1; }.reward-hero text:last-child { color: #cdf6df; font-size: 24rpx; }.reward-section { margin-top: 28rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; }.section-title { display: block; margin-bottom: 20rpx; color: #182d24; font-weight: 700; }.reward-card, .request-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-top: 1rpx solid #edf1ef; }.reward-copy { min-width: 0; flex: 1; }.reward-card strong, .request-row strong { display: block; color: #21352c; }.reward-card text, .request-row text { display: block; margin-top: 6rpx; color: #839189; font-size: 24rpx; }.reward-action { display: flex; flex: 0 0 auto; align-items: center; gap: 18rpx; }.cost { margin-top: 0 !important; color: #07945d !important; font-size: 32rpx !important; font-weight: 800; line-height: 1.2; white-space: nowrap; }.reward-redeem-button { display: flex; flex: 0 0 auto; width: 144rpx; min-width: 144rpx; max-width: 144rpx; height: 56rpx; margin-top: 0; padding: 0; align-items: center; justify-content: center; border: 2rpx solid #0aa868; border-radius: 14rpx; font-size: 22rpx; font-weight: 700; line-height: 1; }.reward-redeem-button--available { background: #eff8f3; color: #078d59; }.reward-redeem-button--disabled, .reward-redeem-button[disabled] { border-color: #d8dfdc; background: #f3f5f4; color: #8a9490; }.status { margin-top: 0 !important; }.status.pending { color: #db8d22; }.status.approved { color: #099a61; }.status.rejected { color: #c75a64; }.empty { color: #9aa59f; font-size: 26rpx; }
