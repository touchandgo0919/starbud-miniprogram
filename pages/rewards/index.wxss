.reward-page { min-height: 100vh; box-sizing: border-box; padding: 28rpx; background: #f3f6f4; color: #17372e; }
.reward-hero { display: flex; flex-direction: column; gap: 12rpx; padding: 40rpx; border: 0; border-radius: 24rpx; background: #08372b; color: #fff; box-shadow: 0 12rpx 32rpx rgba(8, 55, 43, .12); }
.reward-hero strong { font-size: 72rpx; line-height: 1; }.reward-hero text:last-child { color: rgba(255, 255, 255, .78); font-size: 24rpx; }
.reward-section { margin-top: 28rpx; padding: 28rpx; border: 0; border-radius: 20rpx; background: #fff; box-shadow: 0 12rpx 32rpx rgba(28, 49, 41, .06); }
.section-title { display: block; margin-bottom: 20rpx; color: #17372e; font-weight: 700; }.reward-card, .request-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-top: 1rpx solid #e6ece8; }.reward-copy { min-width: 0; flex: 1; }.reward-card strong, .request-row strong { display: block; color: #21352c; }.reward-card text, .request-row text { display: block; margin-top: 6rpx; color: #839189; font-size: 24rpx; }.reward-action { display: flex; flex: 0 0 auto; align-items: center; gap: 18rpx; }.cost { margin-top: 0 !important; color: #07945d !important; font-size: 32rpx !important; font-weight: 800; line-height: 1.2; white-space: nowrap; }.reward-redeem-button { display: flex; flex: 0 0 auto; width: 144rpx; min-width: 144rpx; max-width: 144rpx; height: 56rpx; margin-top: 0; padding: 0; align-items: center; justify-content: center; border: 2rpx solid #0aa868; border-radius: 14rpx; font-size: 22rpx; font-weight: 700; line-height: 1; }.reward-redeem-button--available { background: #0aa868; color: #fff; }.reward-redeem-button--disabled, .reward-redeem-button[disabled] { border-color: #d8dfdc; background: #f3f5f4; color: #8a9490; }.status { margin-top: 0 !important; }.status.pending { color: #db8d22; }.status.approved { color: #099a61; }.status.rejected { color: #c75a64; }.empty { color: #9aa59f; font-size: 26rpx; }
