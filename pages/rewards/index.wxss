.reward-page { min-height: 100vh; padding: 28rpx; background: #f5faf7; box-sizing: border-box; }.reward-hero { display: flex; flex-direction: column; gap: 12rpx; padding: 40rpx; border-radius: 24rpx; color: #eafff4; background: linear-gradient(135deg, #087d54, #18bd78); }.reward-hero strong { font-size: 72rpx; line-height: 1; }.reward-hero text:last-child { color: #cdf6df; font-size: 24rpx; }.reward-section { margin-top: 28rpx; padding: 28rpx; border-radius: 20rpx; background: #fff; }.section-title { display: block; margin-bottom: 20rpx; color: #182d24; font-weight: 700; }.reward-card, .request-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; border-top: 1rpx solid #edf1ef; }.reward-card strong, .request-row strong { display: block; color: #21352c; }.reward-card text, .request-row text { display: block; margin-top: 6rpx; color: #839189; font-size: 24rpx; }.cost { color: #07945d !important; text-align: right; }.reward-card button { margin-top: 10rpx; background: #08a96a; }.status { margin-top: 0 !important; }.status.pending { color: #db8d22; }.status.approved { color: #099a61; }.status.rejected { color: #c75a64; }.empty { color: #9aa59f; font-size: 26rpx; }
