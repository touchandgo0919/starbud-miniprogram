.login-page {
  min-height: 100vh;
  padding: 96rpx 48rpx 56rpx;
  background: #ffffff;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #073b2c;
  font-size: 34rpx;
  font-weight: 800;
}

.login-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
}

.login-copy {
  display: flex;
  margin-top: 104rpx;
  flex-direction: column;
}

.login-title {
  color: #13231e;
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.login-subtitle {
  margin-top: 18rpx;
  color: #7a817e;
  font-size: 28rpx;
}

.login-form {
  margin-top: 72rpx;
}

.field + .field {
  margin-top: 34rpx;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  color: #36413d;
  font-size: 27rpx;
  font-weight: 650;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border: 2rpx solid #dce5e0;
  border-radius: 20rpx;
  background: #fbfcfb;
  color: #18221f;
  font-size: 30rpx;
}

.field-placeholder {
  color: #a4aaa7;
}

.password-control {
  display: flex;
  width: 100%;
  height: 96rpx;
  align-items: center;
  border: 2rpx solid #dce5e0;
  border-radius: 20rpx;
  background: #fbfcfb;
}

.password-input {
  width: 0;
  height: 100%;
  padding: 0 20rpx 0 28rpx;
  flex: 1;
  border: 0;
  border-radius: 20rpx 0 0 20rpx;
  background: transparent;
}

.password-toggle {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  margin-right: 12rpx;
  flex: 0 0 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
}

.password-toggle:active {
  background: #edf4f0;
}

.password-icon {
  width: 36rpx;
  height: 36rpx;
}

.login-error {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #fff0f1;
  color: #b83d48;
  font-size: 25rpx;
  line-height: 1.5;
}

.login-submit {
  margin-top: 44rpx;
}

.login-note {
  position: fixed;
  right: 0;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  left: 0;
  color: #9aa19e;
  font-size: 23rpx;
  text-align: center;
}
