.login-page {
  min-height: 100vh;
  padding: 96rpx 48rpx 56rpx;
  background: #ffffff;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 18rpx;
  color: #073b2c;
  font-size: 34rpx;
  font-weight: 800;
}

.login-logo {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
}

.login-copy {
  display: flex;
  margin-top: 104rpx;
  flex-direction: column;
}

.login-title {
  color: #13231e;
  font-size: 54rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.login-subtitle {
  margin-top: 18rpx;
  color: #7a817e;
  font-size: 28rpx;
}

.login-form {
  margin-top: 72rpx;
}

.field + .field {
  margin-top: 34rpx;
}

.field-label {
  display: block;
  margin-bottom: 16rpx;
  color: #36413d;
  font-size: 27rpx;
  font-weight: 650;
}

.field-input {
  width: 100%;
  height: 96rpx;
  padding: 0 28rpx;
  border: 2rpx solid #dce5e0;
  border-radius: 20rpx;
  background: #fbfcfb;
  color: #18221f;
  font-size: 30rpx;
}

.field-placeholder {
  color: #a4aaa7;
}

.password-control {
  position: relative;
}

.password-input {
  padding-right: 96rpx;
}

.password-toggle {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #68736e;
}

.password-toggle:active {
  background: #edf4f0;
  color: #078d59;
}

.eye-icon {
  position: relative;
  width: 34rpx;
  height: 24rpx;
  border: 3rpx solid currentColor;
  border-radius: 50%;
}

.eye-pupil {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.eye-icon--closed::after {
  position: absolute;
  top: 8rpx;
  left: -5rpx;
  width: 40rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: #fbfcfb;
  box-shadow: 0 0 0 2rpx currentColor;
  content: "";
  transform: rotate(40deg);
}

.login-error {
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  background: #fff0f1;
  color: #b83d48;
  font-size: 25rpx;
  line-height: 1.5;
}

.login-submit {
  margin-top: 44rpx;
}

.login-note {
  position: fixed;
  right: 0;
  bottom: calc(44rpx + env(safe-area-inset-bottom));
  left: 0;
  color: #9aa19e;
  font-size: 23rpx;
  text-align: center;
}
