<view class="home-page">
  <view class="home-hero" style="height: {{navBarHeight + 164}}px;">
    <view class="home-nav" style="height: {{navBarHeight}}px; padding-top: {{statusBarHeight}}px;">
      <view class="home-brand">
        <image src="/assets/starbud-icon.png" mode="aspectFit" />
        <text>星星芽AI助手</text>
      </view>
    </view>
    <view wx:if="{{isParent && parentHome}}" class="home-greeting parent-greeting">
      <text class="home-greeting__date">{{parentHome.dateLabel}}</text>
      <text class="home-greeting__title">{{user.displayName || user.username}}，今天需要跟进</text>
      <text class="home-greeting__copy">只看孩子还需要行动的任务，及时提醒就好。</text>
    </view>
    <view wx:elif="{{home}}" class="home-greeting home-greeting--child">
      <view class="home-greeting__main">
        <text class="home-greeting__date">{{home.dateLabel}}</text>
        <text class="home-greeting__title">{{home.greeting}}，{{user.displayName || user.username}}</text>
        <text class="home-greeting__copy">今天先做好一件事，就很好。</text>
      </view>
      <view class="home-reward-entry" bindtap="openRewards">
        <text class="home-reward-entry__label">星芽积分</text>
        <text class="home-reward-entry__balance">{{rewardBalance}}</text>
        <view class="home-reward-entry__action"><text>去兑换</text><text>›</text></view>
      </view>
    </view>
  </view>

  <view class="home-content">
    <view wx:if="{{loading}}" class="home-state surface">正在整理今天的安排…</view>
    <view wx:elif="{{error && !home && !parentHome}}" class="home-state surface">
      <text class="home-state__title">首页加载失败</text>
      <text class="home-state__copy">{{error}}</text>
      <button class="secondary-button" bindtap="retryHome">重新加载</button>
    </view>

    <block wx:if="{{isParent && parentHome}}">
      <view class="parent-summary surface">
        <view class="parent-summary__head">
          <view><text>今日待跟进</text><text>{{parentHome.childCount ? '涉及 ' + parentHome.childCount + ' 个孩子' : '今天进展顺利'}}</text></view>
          <text class="parent-summary__number">{{parentHome.total}}</text>
        </view>
        <view class="parent-summary__stats">
          <view><text>{{parentHome.counts.claim}}</text><text>待领取</text></view>
          <view><text>{{parentHome.counts.complete}}</text><text>进行中</text></view>
          <view><text>{{parentHome.counts.revision}}</text><text>待修改</text></view>
        </view>
      </view>

      <view class="section-label parent-section-label"><text>未完成项</text><text bindtap="openTasks">查看全部任务</text></view>
      <scroll-view class="parent-task-scroll" scroll-y refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onParentListRefresh">
        <view wx:if="{{!parentHome.pendingTasks.length}}" class="parent-empty surface">
          <view class="parent-empty__mark">✓</view>
          <text class="parent-empty__title">今天没有需要催促的任务</text>
          <text class="parent-empty__copy">孩子已完成或已提交待批改的任务不会出现在这里。</text>
        </view>
        <view wx:else class="parent-task-list surface">
          <view wx:for="{{parentHome.pendingTasks}}" wx:key="id" class="parent-task-row" data-id="{{item.id}}" bindtap="openParentTask">
            <view class="parent-task-mark parent-task-mark--{{item.reminderType}}">{{item.subjectMark}}</view>
            <view class="parent-task-copy">
              <view class="parent-task-meta"><text>{{item.childName}}</text><text>{{item.scheduleTime}}</text><text>{{item.label}}</text></view>
              <text class="parent-task-title">{{item.title}}</text>
              <text class="parent-task-description">{{item.description}}</text>
            </view>
            <parent-remind-button task-id="{{item.id}}" reminder-type="{{item.reminderType}}" label="{{item.actionLabel}}" loading="{{remindingTaskId === item.id}}" bind:remind="remindParentTask" />
          </view>
        </view>
      </scroll-view>
      <text wx:if="{{error}}" class="home-inline-error">{{error}}</text>
    </block>

    <block wx:elif="{{home}}">
      <view class="progress-card surface">
        <view class="progress-card__copy">
          <text>今日进度</text>
          <text class="progress-card__number">{{home.progress.completed}} / {{home.progress.total}}</text>
        </view>
        <view class="progress-track"><view class="progress-track__value" style="width: {{home.progress.percent}}%;"></view></view>
        <text class="progress-card__hint">{{home.progress.pending ? '还有 ' + home.progress.pending + ' 项待完成' : '今天的任务已完成'}}</text>
      </view>

      <view wx:for="{{home.attention}}" wx:key="notificationId" class="attention-card" data-id="{{item.notificationId}}" bindtap="openAttention">
        <view class="attention-card__mark">!</view>
        <view class="attention-card__copy"><text>{{item.title}}</text><text>{{item.description}}</text></view>
        <text class="attention-card__action">{{item.actionLabel}}</text>
      </view>

      <view class="section-label"><text>下一步</text><text bindtap="openTasks">全部任务</text></view>
      <view class="next-card">
        <view class="next-card__head">
          <text>{{home.nextStep.stageLabel}}</text>
        </view>
        <text class="next-card__title">{{home.nextStep.title}}</text>
        <text class="next-card__description">{{home.nextStep.description}}</text>
        <button class="next-card__button" bindtap="openNextStep">{{home.nextStep.actionLabel}}</button>
      </view>

      <view class="encouragement-card surface">
        <view class="encouragement-card__mark">芽</view>
        <view><text class="encouragement-card__title">{{home.encouragement.title}}</text><text class="encouragement-card__copy">{{home.encouragement.description}}</text></view>
      </view>
      <text wx:if="{{error}}" class="home-inline-error">{{error}}</text>
    </block>
  </view>
</view>
