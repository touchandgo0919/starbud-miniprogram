.home-page { min-height: 100vh; padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); background: #f3f6f4; }
.home-hero { padding: 0 26rpx; background: #08372b; color: #ffffff; }
.home-nav { display: flex; box-sizing: border-box; padding-right: 10rpx; padding-left: 10rpx; align-items: center; }
.home-brand { display: flex; align-items: center; gap: 14rpx; font-size: 34rpx; font-weight: 800; }
.home-brand image { width: 48rpx; height: 48rpx; }
.home-greeting { margin-top: 28rpx; padding: 0 10rpx; }
.home-greeting--child { margin-top: 20rpx; padding-right: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.home-greeting__main { min-width: 0; flex: 1; }
.home-greeting text { display: block; }
.home-greeting__date { color: rgba(255, 255, 255, 0.66); font-size: 24rpx; }
.home-greeting__title { overflow: hidden; margin-top: 10rpx; font-size: 46rpx; font-weight: 800; line-height: 1.25; text-overflow: ellipsis; white-space: nowrap; }
.home-greeting__copy { margin-top: 12rpx; color: rgba(255, 255, 255, 0.76); font-size: 27rpx; }
.home-reward-entry { display: flex; width: 176rpx; flex: 0 0 176rpx; flex-direction: column; align-items: flex-end; margin-right: 24rpx; padding: 0; }
.home-reward-entry__label { color: rgba(255, 255, 255, 0.66); font-size: 24rpx; line-height: 1; }
.home-reward-entry__balance { margin-top: 10rpx; color: #ffffff; font-size: 46rpx; font-weight: 800; line-height: 1.25; }
.home-reward-entry__action { display: flex; margin-top: 10rpx; align-items: center; gap: 4rpx; color: #8ee5bb; font-size: 22rpx; font-weight: 750; line-height: 1; }
.home-reward-entry__action text:last-child { font-size: 31rpx; line-height: 18rpx; }
.home-content { position: relative; z-index: 1; margin-top: -66rpx; padding: 0 28rpx; }
.home-state { padding: 72rpx 34rpx; color: #7a817e; text-align: center; }
.home-state text { display: block; }
.home-state__title { color: #26312d; font-size: 31rpx; font-weight: 750; }
.home-state__copy { margin: 12rpx 0 26rpx; font-size: 24rpx; }
.progress-card { padding: 30rpx; box-shadow: 0 12rpx 32rpx rgba(8, 55, 43, 0.08); }
.progress-card__copy { display: flex; align-items: baseline; justify-content: space-between; color: #53605b; font-size: 25rpx; }
.progress-card__number { color: #123c30; font-size: 38rpx; font-weight: 800; }
.progress-track { height: 14rpx; margin-top: 22rpx; overflow: hidden; border-radius: 999rpx; background: #e5ece8; }
.progress-track__value { height: 100%; border-radius: inherit; background: #0aa868; }
.progress-card__hint { display: block; margin-top: 14rpx; color: #87908c; font-size: 23rpx; }
.parent-summary { padding: 28rpx 30rpx; box-shadow: 0 12rpx 32rpx rgba(8, 55, 43, 0.08); }
.parent-summary__head { display: flex; align-items: center; justify-content: space-between; }
.parent-summary__head > view { display: grid; gap: 7rpx; }
.parent-summary__head > view text:first-child { color: #253c34; font-size: 28rpx; font-weight: 800; }
.parent-summary__head > view text:last-child { color: #89928e; font-size: 22rpx; }
.parent-summary__number { color: #0a8b59; font-size: 52rpx; font-weight: 850; line-height: 1; }
.parent-summary__stats { display: grid; margin-top: 26rpx; padding-top: 22rpx; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1rpx solid #e6ece8; }
.parent-summary__stats view { display: grid; gap: 6rpx; border-right: 1rpx solid #e6ece8; text-align: center; }
.parent-summary__stats view:last-child { border-right: 0; }
.parent-summary__stats text:first-child { color: #24352f; font-size: 34rpx; font-weight: 800; }
.parent-summary__stats text:last-child { color: #858e8a; font-size: 22rpx; }
.parent-section-label { margin-top: 30rpx; }
.parent-task-scroll { height: calc(100vh - 650rpx); min-height: 380rpx; }
.parent-task-list { overflow: hidden; }
.parent-task-row { display: grid; min-height: 174rpx; padding: 24rpx; grid-template-columns: 64rpx minmax(0, 1fr) 112rpx; gap: 18rpx; align-items: center; border-bottom: 1rpx solid #e7ece9; }
.parent-task-row:last-child { border-bottom: 0; }
.parent-task-mark { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #fff5db; color: #9a6500; font-size: 25rpx; font-weight: 800; }
.parent-task-mark--complete { background: #eaf8f1; color: #0a8b59; }
.parent-task-mark--revision { background: #fff0f0; color: #d7373d; }
.parent-task-copy { min-width: 0; }
.parent-task-meta { display: flex; min-width: 0; align-items: center; gap: 10rpx; color: #77817c; font-size: 21rpx; }
.parent-task-meta text { white-space: nowrap; }
.parent-task-meta text:last-child { overflow: hidden; padding: 3rpx 8rpx; border-radius: 6rpx; background: #edf5f1; color: #18835b; text-overflow: ellipsis; }
.parent-task-title { display: block; overflow: hidden; margin-top: 10rpx; color: #202d28; font-size: 29rpx; font-weight: 800; text-overflow: ellipsis; white-space: nowrap; }
.parent-task-description { display: -webkit-box; overflow: hidden; margin-top: 7rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 1; color: #8a938f; font-size: 22rpx; line-height: 1.45; }
.parent-empty { padding: 58rpx 34rpx; text-align: center; }
.parent-empty text { display: block; }
.parent-empty__mark { display: flex; width: 64rpx; height: 64rpx; margin: 0 auto 18rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #eaf8f1; color: #0a8b59; font-size: 31rpx; font-weight: 800; }
.parent-empty__title { color: #26352f; font-size: 29rpx; font-weight: 800; }
.parent-empty__copy { margin-top: 10rpx; color: #87908c; font-size: 22rpx; line-height: 1.55; }
.attention-card { display: grid; min-height: 112rpx; margin-top: 20rpx; padding: 22rpx; grid-template-columns: 54rpx minmax(0, 1fr) auto; gap: 16rpx; align-items: center; border: 1rpx solid #f2d18a; border-radius: 20rpx; background: #fff9e9; }
.attention-card__mark { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 16rpx; background: #f4bd42; color: #684500; font-weight: 800; }
.attention-card__copy text { display: block; }
.attention-card__copy text:first-child { color: #43371e; font-size: 25rpx; font-weight: 750; }
.attention-card__copy text:last-child { display: -webkit-box; overflow: hidden; margin-top: 5rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 1; color: #8b7443; font-size: 21rpx; }
.attention-card__action { color: #8b6100; font-size: 22rpx; font-weight: 750; white-space: nowrap; }
.section-label { display: flex; margin: 34rpx 4rpx 16rpx; align-items: center; justify-content: space-between; color: #17372e; font-size: 29rpx; font-weight: 800; }
.section-label text:last-child { color: #0a8b59; font-size: 23rpx; font-weight: 700; }
.next-card { padding: 32rpx; border-radius: 22rpx; background: #ffffff; box-shadow: 0 12rpx 32rpx rgba(28, 49, 41, 0.08); }
.next-card__head { display: flex; height: 34rpx; align-items: center; gap: 12rpx; color: #0a8b59; font-size: 22rpx; font-weight: 800; }
.next-card__title { display: block; margin-top: 15rpx; color: #17251f; font-size: 38rpx; font-weight: 800; line-height: 1.3; }
.next-card__description { display: block; margin-top: 14rpx; color: #6e7974; font-size: 25rpx; line-height: 1.65; }
.next-card__button { display: flex; height: 82rpx; margin-top: 28rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #0aa868; color: #ffffff; font-size: 28rpx; font-weight: 750; }
.encouragement-card { display: grid; margin-top: 20rpx; padding: 26rpx; grid-template-columns: 62rpx minmax(0, 1fr); gap: 18rpx; align-items: center; }
.encouragement-card__mark { display: flex; width: 62rpx; height: 62rpx; align-items: center; justify-content: center; border-radius: 18rpx; background: #e9f8f1; color: #0a8b59; font-size: 24rpx; font-weight: 800; }
.encouragement-card__title, .encouragement-card__copy { display: block; }
.encouragement-card__title { color: #264038; font-size: 26rpx; font-weight: 750; }
.encouragement-card__copy { margin-top: 7rpx; color: #78837e; font-size: 23rpx; line-height: 1.5; }
.home-inline-error { display: block; padding: 20rpx 0 0; color: #be3a3f; font-size: 22rpx; text-align: center; }
